<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ : sauvegarde automatique Android (chiffrée, compte Google de l'utilisateur)
     et transfert vers un nouveau téléphone. Base de données et réglages inclus. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
